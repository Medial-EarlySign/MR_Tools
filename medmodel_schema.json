{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MedModel Configuration",
    "description": "Defines the actions and settings for a model run. This schema provides basic validation and autocompletion. For a full list of all possible attributes and best practices, see the Wiki.",
    "type": "object",
    "properties": {
        "model_json_version": {
            "type": "string",
            "default": "2.0"
        },
        "serialize_learning_set": {
            "type": "string",
            "default": "0",
            "description": "If true will store training samples in the model"
        },
        "generate_masks_for_features": {
            "type": "string",
            "default": "0",
            "description": "If true will store missing values in the features before imputations"
        },
        "max_data_in_mem": {
            "type": "integer",
            "default": 0,
            "description": "If >0, will limit the maximal array size in memory to break into batches. All the features * Nrows is array size. 0 means no limit."
        },
        "take_mean_pred": {
            "type": "string",
            "default": "1"
        },
        "model_actions": {
            "type": "array",
            "description": "Model Components",
            "items": {
                "$ref": "#/$defs/action"
            }
        },
        "predictor": {
            "description": "Medial MedPredictor type",
            "type": "string",
            "enum": [
                "linear_model",
                "qrf",
                "knn",
                "BP",
                "gdlm",
                "xgb",
                "lasso",
                "micNet",
                "deep_bit",
                "lightgbm",
                "svm",
                "linear_sgd",
                "tqrf",
                "bart",
                "external_nn",
                "simple_ensemble",
                "by_missing_value_subset"
            ]
        },
        "predictor_params": {
            "description": "parameters that will be passed to MedPredictor as key=value",
            "type": "string"
        }
    },
    "required": [
        "model_actions",
        "model_json_version"
    ],
    "$defs": {
        "signal": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        },
        "feature_generator": {
            "oneOf": [
                {
                    "title": "Feature Generator Action - Age/Gender",
                    "properties": {
                        "action_type": {
                            "const": "feat_generator"
                        },
                        "fg_type": {
                            "type": "string",
                            "enum": [
                                "age",
                                "gender"
                            ]
                        },
                        "members": false
                    },
                    "required": [
                        "action_type",
                        "fg_type"
                    ],
                    "additionalProperties": true
                },
                {
                    "title": "Feature Generator Action - Basic",
                    "description": "Most Common and Basic Feature generator based on a single signal",
                    "properties": {
                        "action_type": {
                            "const": "feat_generator"
                        },
                        "fg_type": {
                            "const": "basic"
                        },
                        "type": {
                            "oneOf": [
                                {
                                    "type": "string",
                                    "enum": [
                                        "last",
                                        "first",
                                        "last2",
                                        "avg",
                                        "max",
                                        "min",
                                        "std",
                                        "last_delta",
                                        "last_time",
                                        "last2_time",
                                        "slope",
                                        "win_delta",
                                        "category_set",
                                        "category_set_count",
                                        "nsamples",
                                        "exists",
                                        "category_set_first",
                                        "max_diff",
                                        "category_set_sum",
                                        "first_time",
                                        "range_width",
                                        "category_set_first_time",
                                        "sum",
                                        "last_nth",
                                        "category_set_last_nth",
                                        "time_since_last_change"
                                    ]
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "last",
                                            "first",
                                            "last2",
                                            "avg",
                                            "max",
                                            "min",
                                            "std",
                                            "last_delta",
                                            "last_time",
                                            "last2_time",
                                            "slope",
                                            "win_delta",
                                            "category_set",
                                            "category_set_count",
                                            "nsamples",
                                            "exists",
                                            "category_set_first",
                                            "max_diff",
                                            "category_set_sum",
                                            "first_time",
                                            "range_width",
                                            "category_set_first_time",
                                            "sum",
                                            "last_nth",
                                            "category_set_last_nth",
                                            "time_since_last_change"
                                        ]
                                    }
                                }
                            ]
                        },
                        "signal": {
                            "$ref": "#/$defs/signal"
                        },
                        "members": false
                    },
                    "required": [
                        "action_type",
                        "fg_type",
                        "type",
                        "signal"
                    ],
                    "additionalProperties": true
                },
                {
                    "title": "Feature Generator Action - Smoking",
                    "properties": {
                        "action_type": {
                            "const": "feat_generator"
                        },
                        "fg_type": {
                            "const": "unified_smoking"
                        },
                        "smoking_features": {
                            "type": "string"
                        },
                        "members": false
                    },
                    "required": [
                        "action_type",
                        "fg_type",
                        "smoking_features"
                    ],
                    "additionalProperties": true
                },
                {
                    "title": "Feature Generator Action - Time",
                    "properties": {
                        "action_type": {
                            "const": "feat_generator"
                        },
                        "fg_type": {
                            "const": "time"
                        },
                        "time_bins": {
                            "type": "string"
                        },
                        "members": false
                    },
                    "required": [
                        "action_type",
                        "fg_type",
                        "time_bins"
                    ],
                    "additionalProperties": true
                },
                {
                    "title": "Feature Generator Action - singleton",
                    "properties": {
                        "action_type": {
                            "const": "feat_generator"
                        },
                        "fg_type": {
                            "const": "singleton"
                        },
                        "signal": {
                            "$ref": "#/$defs/signal"
                        },
                        "sets": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            ]
                        },
                        "in_set_name": {
                            "type": "string"
                        },
                        "members": false
                    },
                    "required": [
                        "action_type",
                        "fg_type",
                        "signal"
                    ],
                    "additionalProperties": true
                },
                {
                    "title": "Feature Generator Action - binnedLM",
                    "properties": {
                        "action_type": {
                            "const": "feat_generator"
                        },
                        "fg_type": {
                            "type": "string",
                            "enum": [
                                "binnedLm",
                                "binnedLM"
                            ]
                        },
                        "signal": {
                            "$ref": "#/$defs/signal"
                        },
                        "estimation_points": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            ]
                        },
                        "rfactor": {
                            "type": "string"
                        },
                        "min_period": {
                            "type": "string"
                        },
                        "max_period": {
                            "type": "string"
                        },
                        "members": false
                    },
                    "required": [
                        "action_type",
                        "fg_type",
                        "signal",
                        "estimation_points"
                    ],
                    "additionalProperties": true
                },
                {
                    "title": "Feature Generator Action - Range",
                    "properties": {
                        "action_type": {
                            "const": "feat_generator"
                        },
                        "fg_type": {
                            "const": "range"
                        },
                        "signal": {
                            "$ref": "#/$defs/signal"
                        },
                        "type": {
                            "type": "string",
                            "enum": [
                                "current",
                                "latest",
                                "min",
                                "max",
                                "ever",
                                "time_diff",
                                "time_covered",
                                "last_nth_time_len",
                                "time_inside"
                            ]
                        },
                        "sets": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            ]
                        },
                        "div_factor": {
                            "type": "string"
                        },
                        "Nth": {
                            "type": "string"
                        },
                        "members": false
                    },
                    "required": [
                        "action_type",
                        "fg_type",
                        "signal",
                        "type"
                    ],
                    "additionalProperties": true
                },
                {
                    "title": "Feature Generator Action - Category Depend",
                    "properties": {
                        "action_type": {
                            "const": "feat_generator"
                        },
                        "fg_type": {
                            "const": "category_depend"
                        },
                        "signal": {
                            "$ref": "#/$defs/signal"
                        },
                        "val_channel": {
                            "type": "string"
                        },
                        "time_channel": {
                            "type": "string"
                        },
                        "regex_filter": {
                            "type": "string"
                        },
                        "remove_regex_filter": {
                            "type": "string"
                        },
                        "min_age": {
                            "type": "string"
                        },
                        "max_age": {
                            "type": "string"
                        },
                        "age_bin": {
                            "type": "string"
                        },
                        "min_code_cnt": {
                            "type": "string"
                        },
                        "fdr": {
                            "type": "string"
                        },
                        "take_top": {
                            "type": "string"
                        },
                        "filter_hierarchy": {
                            "type": "string"
                        },
                        "lift_below": {
                            "type": "string"
                        },
                        "sort_by_chi": {
                            "type": "string"
                        },
                        "minimal_chi_cnt": {
                            "type": "string"
                        },
                        "use_fixed_lift": {
                            "type": "string"
                        },
                        "feature_prefix": {
                            "type": "string"
                        },
                        "stat_metric": {
                            "type": "string",
                            "enum": [
                                "chi-square",
                                "mcnemar"
                            ]
                        },
                        "max_depth": {
                            "type": "string"
                        },
                        "max_parents": {
                            "type": "string"
                        },
                        "lift_above": {
                            "type": "string"
                        },
                        "generate_with_counts": {
                            "type": "string"
                        },
                        "members": false
                    },
                    "required": [
                        "action_type",
                        "fg_type",
                        "signal"
                    ],
                    "additionalProperties": true
                }
            ]
        },
        "action": {
            "title": "Model Component Action",
            "type": "object",
            "oneOf": [
                {
                    "title": "Feature Generator Action",
                    "$ref": "#/$defs/feature_generator"
                },
                {
                    "title": "Repository Processor Action",
                    "properties": {
                        "action_type": {
                            "const": "rp_set"
                        },
                        "members": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "rp_type": {
                                        "type": "string",
                                        "enum": [
                                            "basic_cln",
                                            "basic_outlier_cleaner",
                                            "nbrs_outlier_cleaner",
                                            "nbrs_cln",
                                            "configured_outlier_cleaner",
                                            "conf_cln",
                                            "rulebased_outlier_cleaner",
                                            "rule_cln",
                                            "calc_signals",
                                            "calculator",
                                            "complete",
                                            "req",
                                            "requirements",
                                            "sim_val",
                                            "sim_val_handler",
                                            "signal_rate",
                                            "combine",
                                            "split",
                                            "aggregation_period",
                                            "basic_range_cleaner",
                                            "range_cln",
                                            "aggregate",
                                            "history_limit",
                                            "create_registry",
                                            "bit_signal",
                                            "category_descenders",
                                            "reoder_channels",
                                            "filter_channels",
                                            "numeric_noiser",
                                            "filter_by_diag"
                                        ]
                                    },
                                    "signal": {
                                        "$ref": "#/$defs/signal"
                                    },
                                    "required": [
                                        "rp_type",
                                        "signal"
                                    ],
                                    "additionalProperties": true
                                }
                            }
                        },
                        "required": [
                            "action_type",
                            "members"
                        ],
                        "additionalProperties": true
                    }
                },
                {
                    "title": "Feature Processor Action",
                    "properties": {
                        "action_type": {
                            "const": "fp_set"
                        },
                        "members": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "rp_type": {
                                        "type": "string",
                                        "enum": [
                                            "basic_cleaner",
                                            "basic_outlier_cleaner",
                                            "normalizer",
                                            "imputer",
                                            "do_calc",
                                            "univariate_selector",
                                            "mrmr",
                                            "mrmr_selector",
                                            "lasso",
                                            "tags_selector",
                                            "importance_selector",
                                            "iterative_selector",
                                            "remove_deg",
                                            "iterative_imputer",
                                            "pca",
                                            "one_hot",
                                            "get_prob",
                                            "predcitor_imputer",
                                            "multiplier",
                                            "resample_with_missing",
                                            "duplicate",
                                            "missing_indicator",
                                            "binning"
                                        ]
                                    },
                                    "signal": {
                                        "$ref": "#/$defs/signal"
                                    },
                                    "required": [
                                        "fp_type",
                                        "signal"
                                    ],
                                    "duplicate": {
                                        "type": "string"
                                    },
                                    "additionalProperties": true
                                }
                            }
                        },
                        "required": [
                            "action_type",
                            "members"
                        ],
                        "additionalProperties": true
                    }
                },
                {
                    "title": "Post Processor Action",
                    "properties": {
                        "action_type": {
                            "const": "pp_set"
                        },
                        "members": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "pp_type": {
                                        "type": "string",
                                        "enum": [
                                            "calibrator",
                                            "lime_shap",
                                            "shapley",
                                            "missing_shap",
                                            "iterative_set",
                                            "tree_shap",
                                            "aggregate_preds",
                                            "adjust_probs",
                                            "fairness_adjust"
                                        ]
                                    },
                                    "required": [
                                        "pp_type"
                                    ],
                                    "additionalProperties": true
                                }
                            }
                        },
                        "required": [
                            "action_type",
                            "members"
                        ],
                        "additionalProperties": true
                    }
                }
            ]
        }
    }
}